#!/bin/bash

# Sets the release version in VERSION and formula/ih-core.rb.
# With no argument, prints the current version.
# Commit the result in the same PR as your change. A merged PR releases the new version.

THIS_DIR=$(dirname "$(realpath "$0")")
ROOT_DIR=$(dirname "$THIS_DIR")

if [[ $# -eq 0 ]]; then
  cat "$ROOT_DIR/VERSION"
  exit 0
fi

VERSION=$1
set -e

if [ "$(uname)" = "Linux" ]; then
  sed -i "s/VERSION=.*/VERSION=\"$VERSION\"/" "$ROOT_DIR/formula/ih-core.rb"
else
  sed -i '' "s/VERSION=.*/VERSION=\"$VERSION\"/" "$ROOT_DIR/formula/ih-core.rb"
fi
echo "$VERSION" >"$ROOT_DIR/VERSION"
echo "Version set to $VERSION in VERSION and formula/ih-core.rb."
